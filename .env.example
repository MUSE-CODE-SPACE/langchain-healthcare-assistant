# =============================================================================
# Healthcare Assistant — environment variables
# =============================================================================
# Copy this file to `.env` and fill in the values you need.
# The app runs WITHOUT any keys (LLM_PROVIDER=none → deterministic keyword
# router) — keys only unlock the real-LLM mode.

# Which LLM backend to use: "anthropic" | "openai" | "none"
# Leave empty to auto-detect from whichever API key is present.
LLM_PROVIDER=

# Anthropic (Claude). Required when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-haiku-5-5
ANTHROPIC_MODEL=

# OpenAI. Required when LLM_PROVIDER=openai.
OPENAI_API_KEY=
# Optional override; defaults to gpt-5.4-mini
OPENAI_MODEL=

# Flask
PORT=5000
FLASK_DEBUG=1
